{
  "name": "Family Calendar",
  "short_name": "Family",
  "description": "Plans, lists and stickers for the whole family.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#faf7f2",
  "theme_color": "#faf7f2",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Add event", "short_name": "Add", "url": "./?add=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lists", "short_name": "Lists", "url": "./?tab=lists", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
